local isResizing, startSize, startMousePos = false, nil, nil

ResizeButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isResizing = true
        startSize = MainFrame.Size
        startMousePos = UserInputService:GetMouseLocation()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isResizing and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = UserInputService:GetMouseLocation() - startMousePos
        if not isMinimized then
            MainFrame.Size = UDim2.new(0, math.max(240, startSize.X.Offset + delta.X), 0, math.max(160, startSize.Y.Offset + delta.Y))
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then isResizing = false end
end)

