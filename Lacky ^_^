    else Tb.BackgroundColor3,Tb.Text,L1.Text,L1.TextColor3 = Color3.fromRGB(160,60,60),"OFF","Status: OFF",Color3.fromRGB(255,130,130) if con then con:Disconnect() con = nil end end
end)

