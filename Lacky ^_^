local function spyOn(targetPlayer)
    if targetPlayer and targetPlayer.Character then
        local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if targetHumanoid then
            Camera.CameraSubject = targetHumanoid
        end
    end
end

local function updatePlayerList()
    for _, child in pairs(ScrollList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local count = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            count = count + 1
            local PButton = Instance.new("TextButton")
            PButton.Size = UDim2.new(1, -5, 0, 25)
            PButton.BackgroundColor3 = Color3.fromRGB(30, 75, 95)
            PButton.BackgroundTransparency = 0.2
            PButton.Text = p.Name
            PButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            PButton.TextSize = 13
            PButton.Font = Enum.Font.SourceSans
            PButton.Parent = ScrollList
            
            local PCorner = Instance.new("UICorner")
            PCorner.CornerRadius = UDim.new(0, 4)
            PCorner.Parent = PButton
            
            PButton.MouseButton1Click:Connect(function()
                selectedPlayer = p
                spyOn(p)
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, count * 29)
end

RunService.RenderStepped:Connect(function()
    if selectedPlayer and Camera.CameraSubject ~= (selectedPlayer.Character and selectedPlayer.Character:FindFirstChildOfClass("Humanoid")) then
        spyOn(selectedPlayer)
    end
end)

UnspyButton.MouseButton1Click:Connect(function()
    selectedPlayer = nil
