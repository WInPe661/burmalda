        SpyFrame.Visible = false
        MainFrame.Size = UDim2.new(0, 220, 0, 30)
        MinimizeButton.Text = "+"
    else
        ContentFrame.Visible = true
        if isSpyOpen then SpyFrame.Visible = true end
        MainFrame.Size = UDim2.new(0, 220, 0, 150)
        MinimizeButton.Text = "-"
    end
end)
