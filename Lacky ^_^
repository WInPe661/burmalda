        local b2 = Instance.new("TextButton",Sl2) b2.Size = UDim2.new(1,-5,0,22) b2.BackgroundColor3 = Color3.fromRGB(30,75,95) b2.Text = p.Name b2.TextColor3 = Color3.fromRGB(255,255,255) b2.TextSize = 12 b2.Font = 3 Instance.new("UICorner",b2).CornerRadius = UDim.new(0,4)
        b2.MouseButton1Click:Connect(function() spy(p) end)
        
        local b3 = Instance.new("TextButton",Sl3) b3.Size = UDim2.new(1,-5,0,22) b3.BackgroundColor3 = Color3.fromRGB(30,75,95) b3.Text = p.Name b3.TextColor3 = Color3.fromRGB(255,255,255) b3.TextSize = 12 b3.Font = 3 Instance.new("UICorner",b3).CornerRadius = UDim.new(0,4)
        b3.MouseButton1Click:Connect(function() sel = p L3.Text,L3.TextColor3 = "Target: "..p.Name,Color3.fromRGB(255,255,255) end)
