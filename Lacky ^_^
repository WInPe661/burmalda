local function prot()
    local c = pl.Character if not c then return end local r = c:FindFirstChild("HumanoidRootPart") if r and r.Anchored then r.Anchored = false end local h = c:FindFirstChildOfClass("Humanoid") if h and h.SeatPart then h.Jump = true end
    for _,p in pairs(c:GetChildren()) do if p:IsA("BasePart") then for _,o in pairs(p:GetChildren()) do if o:IsA("Weld") or o:IsA("ManualWeld") or o:IsA("WeldConstraint") then if o.Name ~= "RightGrip" and o.Name ~= "LeftGrip" then o:Destroy() end elseif o:IsA("BodyPosition") or o:IsA("BodyGyro") or o:IsA("RocketPropulsion") then o:Destroy() end end end end
end
