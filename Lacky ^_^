local rzEdge, sSz, sPs, sMp = nil, nil, nil, nil
local function cEz(n, sz, ps)
    local e = Instance.new("TextButton", M) e.Name = n e.Size = sz e.Position = ps e.BackgroundTransparency = 1 e.Text = "" e.ZIndex = 10
    e.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 and not min then rzEdge,sSz,sPs,sMp = n,M.Size,M.Position,U:GetMouseLocation() end end)
end
cEz("R", UDim2.new(0,6,1,0), UDim2.new(1,-3,0,0))
cEz("L", UDim2.new(0,6,1,0), UDim2.new(0,-3,0,0))
cEz("B", UDim2.new(1,0,0,6), UDim2.new(0,0,1,-3))
cEz("T", UDim2.new(1,0,0,6), UDim2.new(0,0,0,-3))

U.InputChanged:Connect(function(i)
    if rzEdge and i.UserInputType == Enum.UserInputType.MouseMovement and not min then
        local d = U:GetMouseLocation() - sMp
        if rzEdge == "R" then M.Size = UDim2.new(0, math.max(240, sSz.X.Offset + d.X), 0, sSz.Y.Offset)
        elseif rzEdge == "B" then M.Size = UDim2.new(0, sSz.X.Offset, 0, math.max(160, sSz.Y.Offset + d.Y))
        elseif rzEdge == "L" then 
            local nW = math.max(240, sSz.X.Offset - d.X)
            if nW > 240 then M.Size, M.Position = UDim2.new(0, nW, 0, sSz.Y.Offset), UDim2.new(0, sPs.X.Offset + d.X, 0, sPs.Y.Offset) end
        elseif rzEdge == "T" then 
            local nH = math.max(160, sSz.Y.Offset - d.Y)
            if nH > 160 then M.Size, M.Position = UDim2.new(0, sSz.X.Offset, 0, nH), UDim2.new(0, sPs.X.Offset, 0, sPs.Y.Offset + d.Y) end
        end
    end
end)
U.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then rzEdge = nil end end)

